# ==============================================================================
# Local Development Environment Configuration Template
# Copy this file to .env.development:
#   cp .env.development.example .env.development
# ==============================================================================

# Runtime Environment
ENVIRONMENT=development
NODE_ENV=development
APP_MODE=development

# Server Port (8083 is the standard default for Calibre-Web)
PORT=8083
CALIBRE_PORT=8083

# Secret Key for Flask sessions (use a secure random string in production)
CALIBRE_SECRET_KEY=dev-flask-session-secret-change-me

# Calibre Library / Configuration Directory
CALIBRE_DBPATH=/app

# THC Backbone Authentication Integration (Local Dev)
CALIBRE_BACKBONE_ENABLED=true
CALIBRE_BACKBONE_URL=http://localhost:8080
CALIBRE_BACKBONE_INTERNAL_URL=http://localhost:8080
CALIBRE_BACKBONE_JWT_SECRET=be478f51c1d622108e8dc0d99d5845af4435fe92e2464d9a7c1dbb75c1fd04e3
CALIBRE_BACKBONE_AUTO_REGISTER=false
