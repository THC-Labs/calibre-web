# ==============================================================================
# VPS Production Environment Configuration Template
# In the central VPS (/opt/thclabs), these keys can be added to the shared .env
# All variables are namespaced with CALIBRE_ to prevent cross-service collisions
# ==============================================================================

# Runtime Environment
ENVIRONMENT=production
NODE_ENV=production
APP_MODE=production

# Server Port (Target container internal port 8083)
PORT=8083
CALIBRE_PORT=8083

# Flask Secret Key
# Generate a secure key: python3 -c "import secrets; print(secrets.token_hex(32))"
CALIBRE_SECRET_KEY=replace_with_a_secure_random_64_char_flask_secret_key

# Calibre Database / Configuration Directory
CALIBRE_DBPATH=/app

# THC Backbone Authentication Integration
CALIBRE_BACKBONE_ENABLED=true
CALIBRE_BACKBONE_URL=https://auth.thclabs.org
CALIBRE_BACKBONE_INTERNAL_URL=http://backend:8080
CALIBRE_BACKBONE_JWT_SECRET=replace_with_shared_backbone_jwt_secret
CALIBRE_BACKBONE_AUTO_REGISTER=false
